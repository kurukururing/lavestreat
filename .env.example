# Katalog lengkap: docs/TECH_STACK.md Bagian 11. Jangan isi nilai asli di file ini.
# Salin ke backend/.env (back-end + skrip) dan ai-service/.env (layanan AI).

# --- backend ---
NODE_ENV=development
PORT=3000
# Neon pooled, dipakai aplikasi lewat @prisma/adapter-pg
DATABASE_URL=
# Neon direct, dipakai CLI Prisma untuk migrasi
DIRECT_URL=
SESSION_SECRET=
IP_HASH_SALT=
APP_ORIGIN=http://localhost:5173
FRONTEND_DIST_DIR=../frontend/dist
TRUST_PROXY_HOPS=0
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_KEY=
AI_TIMEOUT_MS=10000
SERVICE_AREA_BBOX=

# --- skrip admin:create dan admin:reset saja (tidak dibaca server) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- ai-service (PORT dan AI_INTERNAL_KEY juga dipakai di sini) ---
GEMINI_API_KEY=
GEMINI_MODEL=
DOCS_ENABLED=false

# --- frontend (dev saja, opsional; tidak boleh berisi rahasia) ---
VITE_DEV_API_TARGET=http://localhost:3000
